# ==============================================================================
# AMEVA-Forge Master .gitignore
# ==============================================================================

# Node.js
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# IDE / Editor
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Build / Output directories
/releases/
/reports/**/*.txt
/reports/**/*.log
/reports/**/*.json
/reports/tests/*.txt
/reports/*.txt
/reports/*.json
*.log

# Binary & Package Distribution Artifacts (WHL, TGZ, TAR.GZ)
*.whl
!docs/pkg/*.whl
*.tar.gz
*.tgz
*.egg-info/
packages/forge-py/build/
packages/forge-py/dist/
packages/forge-py/src/forge.egg-info/
packages/forge/test-artifacts/
packages/test-artifacts/
packages/forge-py/tests/test_results.json

# Model weights
!docs/experimental/playgrounds/mnist-weights.js
!docs/experimental/playgrounds/mnist/mnist-weights.js
!docs/experimental/playgrounds/mnist_weights.json
!docs/experimental/playgrounds/mnist/mnist_weights.json

# Python
__pycache__/
*.py[cod]
*.class
venv/
.venv/
scripts/venv/
.pytest_cache/
.coverage

# Temporary Logs, Scratch & Benchmarks
docs/tests/results/
scripts/codes/
scripts/__pycache__/
scripts/scratch/
.temp_logs/
docs/audits/
packages/forge/test-results/
packages/forge/docs/
packages/forge/packages/
test-results/
scratch/
tmp/
temp/
*.tmp
.cache/
.turbo/
state.json
diff.txt
diff_utf8.txt

# ==============================================================================
# Security & Credentials Isolation Policy (Zero-Token Leakage)
# ==============================================================================
.env*
!.env.example
*.env
*.secret
*.secrets
*credentials*
*.token
*.pem
*.key
*.pfx
*.pkcs12
*.crt
*.cert
id_rsa*
id_ed25519*
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
*.dump
.pypirc
.npmrc
secrets.json
secrets/
