{
  "name": "@ameva/forge",
  "version": "0.1.0",
  "description": "High-Performance Browser-Native Tensor Computation Engine & Reverse-Mode Autograd Framework Powered by WebGPU",
  "repository": {
    "type": "git",
    "url": "https://github.com/uno-km/ameva-forge.git"
  },
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rollup -c rollup.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathIgnorePatterns=tests/e2e",
    "test:e2e": "playwright test",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-typescript": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.2.0",
    "@webgpu/types": "^0.1.34",
    "jest": "^29.0.0",
    "rollup": "^3.0.0",
    "ts-jest": "^29.4.12",
    "tslib": "^2.6.0",
    "typescript": "^5.0.0"
  }
}
